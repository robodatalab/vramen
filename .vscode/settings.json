{
	// Python tests are unittest. Discovery starts in `tests`, with the top-level
	// directory left at the repo root; `vramen` itself is importable from the
	// editable install in `.venv`, not from the source tree.
	"python.testing.unittestEnabled": true,
	"python.testing.pytestEnabled": false,
	"python.testing.cwd": "${workspaceFolder}",
	"python.testing.unittestArgs": [
		"-v",
		"-s",
		"tests",
		"-t",
		".",
		"-p",
		"test_*.py"
	],
	"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
